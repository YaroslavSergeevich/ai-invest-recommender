# Backend
PORT=8080

# PostgreSQL (в docker-compose: postgres, локально: localhost)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
USERS_DB=users_db
NEWS_DB=news_db

# Model A (analyser service)
# В docker-compose: http://analyser:8000/classify
# Локально без docker: http://localhost:8000/classify
MODEL_A_URL=http://analyser:8000/classify

# Model B (external API)
MODEL_B_BASE_URL=https://changellenge.up.railway.app/v1
MODEL_B_API_KEY=your_api_key_here
MODEL_B_MODEL=deepseek/deepseek-v4.1-flash

# Доступные модели Model B:
# google/gemma-4-26b-a4b-it
# z-ai/glm-5.3-flash
# qwen/qwen3.6-35b-a3b
# deepseek/deepseek-v4.1-flash
# qwen/qwen3-vl-30b-a3b-instruct
# moonshotai/kimi-k2.6

# Daemon
DAEMON_POLL_INTERVAL=300
DAEMON_SOURCES_CONFIG=/app/daemon/sources.yaml

# CSV data path
CSV_DATA_PATH=../../Библиотека исследований/Выгрузки датафреймов

# Analytics Source Simulator (PDF reports)
# Абсолютный путь к папке с PDF на хосте (кавычки для пробелов/кириллицы)
PDF_HOST_DIR="/absolute/path/Аналитические материалы"